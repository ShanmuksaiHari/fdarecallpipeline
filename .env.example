# Copy this file to .env and fill in your own values.
# .env is ignored by git, so real keys are never committed.

# openFDA API key (optional; the pipeline works without it at a lower rate limit)
FDA_API_KEY=your-openfda-key

# AWS credentials for an IAM user that can read and write the bronze bucket
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# S3 bucket that holds the bronze layer
AWS_BUCKET_NAME=your-bucket-name
